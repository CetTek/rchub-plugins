{
  "id": "com.rchub.media",
  "name": {
    "en": "Media & Display",
    "tr": "Medya ve Ekran"
  },
  "description": {
    "en": "Volume, brightness and playback in one panel.",
    "tr": "Ses, parlaklık ve oynatma tek panelde."
  },
  "license": "MIT",
  "targets": [
    "windows"
  ],
  "actions": [
    {
      "capability": "audio.read",
      "id": "audio_read",
      "input": {
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output": {
        "properties": {
          "muted": {
            "type": "boolean"
          },
          "volume": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "volume",
          "muted"
        ],
        "type": "object"
      }
    },
    {
      "capability": "audio.write",
      "id": "audio_set_volume",
      "input": {
        "properties": {
          "volume": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "volume"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "muted": {
            "type": "boolean"
          },
          "volume": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "volume",
          "muted"
        ],
        "type": "object"
      }
    },
    {
      "capability": "audio.write",
      "id": "audio_set_mute",
      "input": {
        "properties": {
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "muted"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "muted": {
            "type": "boolean"
          },
          "volume": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "volume",
          "muted"
        ],
        "type": "object"
      }
    },
    {
      "capability": "display.read",
      "id": "display_read",
      "input": {
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output": {
        "properties": {
          "available": {
            "type": "boolean"
          },
          "brightness": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "brightness",
          "available"
        ],
        "type": "object"
      }
    },
    {
      "capability": "display.write",
      "id": "display_set",
      "input": {
        "properties": {
          "brightness": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "brightness"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "available": {
            "type": "boolean"
          },
          "brightness": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "brightness",
          "available"
        ],
        "type": "object"
      }
    },
    {
      "capability": "media.write",
      "id": "media_control",
      "input": {
        "properties": {
          "action": {
            "enum": [
              "play_pause",
              "next",
              "previous"
            ],
            "maxLength": 10,
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ],
        "type": "object"
      }
    }
  ],
  "state": {
    "accepted": {
      "type": "boolean"
    },
    "available": {
      "type": "boolean"
    },
    "brightness": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "muted": {
      "type": "boolean"
    },
    "volume": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    }
  },
  "ui": {
    "color": "blue",
    "controls": [
      {
        "children": [
          {
            "action": "audio_set_volume",
            "argument": "volume",
            "bind": "volume",
            "icon": "volume",
            "id": "volume",
            "label": {
              "en": "Volume",
              "tr": "Ses düzeyi"
            },
            "max": 100,
            "min": 0,
            "step": 1,
            "type": "slider"
          },
          {
            "action": "audio_set_mute",
            "argument": "muted",
            "bind": "muted",
            "icon": "volume",
            "id": "mute",
            "label": {
              "en": "Mute",
              "tr": "Sessize al"
            },
            "type": "toggle"
          }
        ],
        "id": "audio_row",
        "type": "row"
      },
      {
        "action": "display_set",
        "argument": "brightness",
        "bind": "brightness",
        "icon": "sun",
        "id": "brightness",
        "label": {
          "en": "Brightness",
          "tr": "Parlaklık"
        },
        "max": 100,
        "min": 0,
        "step": 1,
        "type": "slider"
      },
      {
        "children": [
          {
            "children": [
              {
                "action": "media_control",
                "argument": "action",
                "icon": "play",
                "id": "previous",
                "label": {
                  "en": "Previous",
                  "tr": "Önceki"
                },
                "type": "button",
                "value": "previous"
              },
              {
                "action": "media_control",
                "argument": "action",
                "icon": "play",
                "id": "play_pause",
                "label": {
                  "en": "Play / pause",
                  "tr": "Oynat / duraklat"
                },
                "tone": "primary",
                "type": "button",
                "value": "play_pause"
              },
              {
                "action": "media_control",
                "argument": "action",
                "icon": "play",
                "id": "next",
                "label": {
                  "en": "Next",
                  "tr": "Sonraki"
                },
                "type": "button",
                "value": "next"
              }
            ],
            "id": "playback_row",
            "type": "row"
          }
        ],
        "icon": "play",
        "id": "playback_section",
        "label": {
          "en": "Playback Controls",
          "tr": "Oynatma Kontrolleri"
        },
        "type": "section"
      }
    ],
    "icon": "volume",
    "version": 1
  },
  "sourceFormat": "rchub-official-native-source-1",
  "version": "1.0.0",
  "requiredFeatures": [
    "native-process-v1",
    "surfaces-v1",
    "surface-metadata-v1"
  ],
  "disclosure": {
    "nativeRisk": {
      "en": "This native executable is not sandboxed. It runs as your current PC user and can access that user’s files, network, devices and applications.",
      "tr": "Bu yerel çalıştırılabilir dosya sandbox içinde değildir. Mevcut PC kullanıcınız olarak çalışır; bu kullanıcının dosyalarına, ağına, aygıtlarına ve uygulamalarına erişebilir."
    },
    "dataBehavior": {
      "en": "Reads and changes audio and brightness, and sends media playback keys.",
      "tr": "Ses ve parlaklığı okur ve değiştirir; medya oynatma tuşları gönderir."
    }
  }
}
