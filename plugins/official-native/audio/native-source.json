{
  "id": "com.rchub.audio",
  "name": {
    "en": "Audio",
    "tr": "Ses"
  },
  "description": {
    "en": "Control default Windows output volume and mute.",
    "tr": "Varsayılan Windows çıkış sesini ve sessiz durumunu yönetin."
  },
  "license": "MIT",
  "targets": [
    "windows"
  ],
  "actions": [
    {
      "capability": "audio.read",
      "id": "read",
      "input": {
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output": {
        "properties": {
          "muted": {
            "type": "boolean"
          },
          "volume": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "volume",
          "muted"
        ],
        "type": "object"
      }
    },
    {
      "capability": "audio.write",
      "id": "set_volume",
      "input": {
        "properties": {
          "volume": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "volume"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "muted": {
            "type": "boolean"
          },
          "volume": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "volume",
          "muted"
        ],
        "type": "object"
      }
    },
    {
      "capability": "audio.write",
      "id": "set_mute",
      "input": {
        "properties": {
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "muted"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "muted": {
            "type": "boolean"
          },
          "volume": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "volume",
          "muted"
        ],
        "type": "object"
      }
    }
  ],
  "state": {
    "muted": {
      "type": "boolean"
    },
    "volume": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    }
  },
  "ui": {
    "color": "blue",
    "controls": [
      {
        "children": [
          {
            "action": "set_volume",
            "argument": "volume",
            "bind": "volume",
            "icon": "volume",
            "id": "volume",
            "label": {
              "en": "Volume",
              "tr": "Ses düzeyi"
            },
            "max": 100,
            "min": 0,
            "step": 1,
            "type": "slider"
          },
          {
            "action": "set_mute",
            "argument": "muted",
            "bind": "muted",
            "id": "mute",
            "label": {
              "en": "Mute",
              "tr": "Sessize al"
            },
            "type": "toggle"
          }
        ],
        "icon": "volume",
        "id": "audio",
        "label": {
          "en": "Output",
          "tr": "Çıkış"
        },
        "type": "section"
      }
    ],
    "icon": "volume",
    "version": 1
  },
  "sourceFormat": "rchub-official-native-source-1",
  "version": "1.0.0",
  "requiredFeatures": [
    "native-process-v1",
    "surfaces-v1",
    "surface-metadata-v1"
  ],
  "disclosure": {
    "nativeRisk": {
      "en": "This native executable is not sandboxed. It runs as your current PC user and can access that user’s files, network, devices and applications.",
      "tr": "Bu yerel çalıştırılabilir dosya sandbox içinde değildir. Mevcut PC kullanıcınız olarak çalışır; bu kullanıcının dosyalarına, ağına, aygıtlarına ve uygulamalarına erişebilir."
    },
    "dataBehavior": {
      "en": "Reads and changes the default Windows output endpoint.",
      "tr": "Varsayılan Windows ses çıkışını okur ve değiştirir."
    }
  }
}
