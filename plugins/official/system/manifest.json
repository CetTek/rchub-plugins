    "os": {
      "maxLength": 120,
      "type": "string"
    },
    "ram_total_mb": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "ram_usage_percent": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "ram_used_mb": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "uptime_seconds": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    }
  },
