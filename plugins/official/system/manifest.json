      {
        "children": [
          {
            "appearance": "ring",
            "bind": "cpu_usage",
            "id": "cpu_usage",
            "label": {
              "en": "CPU",
              "tr": "CPU"
            },
            "max": 100,
            "min": 0,
            "type": "progress"
          },
          {
            "appearance": "ring",
            "bind": "ram_usage_percent",
            "id": "ram_usage",
            "label": {
              "en": "Memory usage",
              "tr": "Bellek kullanımı"
            },
            "max": 100,
            "min": 0,
            "type": "progress"
          }
        ],
        "id": "gauges",
        "type": "row"
      },
      {
        "children": [
          {
            "bind": "ram_used_mb",
            "id": "ram_used_mb",
            "label": {
              "en": "Used memory (MB)",
              "tr": "Kullanılan bellek (MB)"
            },
            "type": "value"
          },
          {
            "bind": "ram_total_mb",
            "id": "ram_total_mb",
            "label": {
              "en": "Total memory (MB)",
              "tr": "Toplam bellek (MB)"
            },
            "type": "value"
          }
        ],
        "id": "memory",
        "type": "row"
      },
      {
        "bind": "os",
        "id": "os",
        "label": {
          "en": "Operating system",
          "tr": "İşletim sistemi"
        },
        "type": "value"
      },
      {
        "bind": "hostname",
        "id": "hostname",
        "label": {
          "en": "Computer",
          "tr": "Bilgisayar"
        },
        "type": "value"
      },
      {
        "bind": "uptime_seconds",
        "id": "uptime_seconds",
        "label": {
          "en": "Uptime (seconds)",
          "tr": "Çalışma süresi (saniye)"
        },
        "type": "value"
      }
