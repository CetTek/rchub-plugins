{
  "actions": [
    {
      "capability": "keyboard.write",
      "entry": 0,
      "id": "type_text",
      "input": {
        "properties": {
          "text": {
            "maxLength": 4096,
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "sent": {
            "type": "boolean"
          }
        },
        "required": [
          "sent"
        ],
        "type": "object"
      }
    },
    {
      "capability": "keyboard.write",
      "entry": 1,
      "id": "shortcut",
      "input": {
        "properties": {
          "keys": {
            "maxLength": 80,
            "type": "string"
          }
        },
        "required": [
          "keys"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "sent": {
            "type": "boolean"
          }
        },
        "required": [
          "sent"
        ],
        "type": "object"
      }
    }
  ],
  "description": {
    "en": "Type text and send keyboard shortcuts.",
    "tr": "Metin yazın ve klavye kısayolları gönderin."
  },
  "hostApi": 1,
  "id": "com.rchub.keyboard",
  "license": "MIT",
  "name": {
    "en": "Keyboard",
    "tr": "Klavye"
  },
  "permissions": [
    "keyboard.write"
  ],
  "publisher": {
    "kind": "official",
    "name": "RCHub"
  },
  "schemaVersion": 1,
  "source": "https://github.com/CetTek/rchub-plugins/tree/v0.3.0/plugins/official/keyboard",
  "state": {
    "sent": {
      "type": "boolean"
    }
  },
  "targets": [
    "windows"
  ],
  "ui": {
    "color": "purple",
    "controls": [
      {
        "children": [
          {
            "children": [
              {
                "action": "type_text",
                "argument": "text",
                "id": "text",
                "label": {
                  "en": "Type on PC",
                  "tr": "PC’de yaz"
                },
                "multiline": true,
                "placeholder": {
                  "en": "Write a message or paste multiple lines",
                  "tr": "Bir ileti yazın veya çok satırlı metin yapıştırın"
                },
                "type": "input"
              }
            ],
            "id": "typing",
            "label": {
              "en": "Text",
              "tr": "Metin"
            },
            "type": "section"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "action": "shortcut",
                    "argument": "keys",
                    "id": "copy",
                    "label": {
                      "en": "Copy",
                      "tr": "Kopyala"
                    },
                    "type": "button",
                    "value": "ctrl+c"
                  },
                  {
                    "action": "shortcut",
                    "argument": "keys",
                    "id": "paste",
                    "label": {
                      "en": "Paste",
                      "tr": "Yapıştır"
                    },
                    "type": "button",
                    "value": "ctrl+v"
                  },
                  {
                    "action": "shortcut",
                    "argument": "keys",
                    "id": "select_all",
                    "label": {
                      "en": "Select all",
                      "tr": "Tümünü seç"
                    },
                    "type": "button",
                    "value": "ctrl+a"
                  },
                  {
                    "action": "shortcut",
                    "argument": "keys",
                    "id": "undo",
                    "label": {
                      "en": "Undo",
                      "tr": "Geri al"
                    },
                    "type": "button",
                    "value": "ctrl+z"
                  },
                  {
                    "action": "shortcut",
                    "argument": "keys",
                    "id": "enter",
                    "label": {
                      "en": "Enter",
                      "tr": "Enter"
                    },
                    "type": "button",
                    "value": "enter"
                  },
                  {
                    "action": "shortcut",
                    "argument": "keys",
                    "id": "escape",
                    "label": {
                      "en": "Escape",
                      "tr": "Escape"
                    },
                    "type": "button",
                    "value": "esc"
                  },
                  {
                    "action": "shortcut",
                    "argument": "keys",
                    "id": "switch",
                    "label": {
                      "en": "Switch app",
                      "tr": "Uygulama değiştir"
                    },
                    "type": "button",
                    "value": "alt+tab"
                  },
                  {
                    "action": "shortcut",
                    "argument": "keys",
                    "id": "desktop",
                    "label": {
                      "en": "Show desktop",
                      "tr": "Masaüstünü göster"
                    },
                    "type": "button",
                    "value": "win+d"
                  }
                ],
                "id": "quick_keys",
                "type": "row"
              },
              {
                "action": "shortcut",
                "argument": "keys",
                "id": "shortcut",
                "label": {
                  "en": "Shortcut (e.g. ctrl+a)",
                  "tr": "Kısayol (ör. ctrl+a)"
                },
                "type": "input"
              }
            ],
            "id": "shortcuts",
            "label": {
              "en": "Shortcuts",
              "tr": "Kısayollar"
            },
            "type": "section"
          }
        ],
        "id": "keyboard_tabs",
        "type": "tabs"
      },
      {
        "bind": "sent",
        "id": "sent",
        "label": {
          "en": "Sent",
          "tr": "Gönderildi"
        },
        "type": "status"
      }
    ],
    "icon": "keyboard",
    "version": 1
  },
  "version": "0.3.0"
}
