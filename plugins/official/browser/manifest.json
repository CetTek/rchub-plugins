{
  "actions": [
    {
      "capability": "browser.open",
      "entry": 0,
      "id": "open",
      "input": {
        "properties": {
          "url": {
            "maxLength": 2048,
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "opened": {
            "type": "boolean"
          }
        },
        "required": [
          "opened"
        ],
        "type": "object"
      }
    }
  ],
  "description": {
    "en": "Open an HTTP(S) website on your PC.",
    "tr": "PC’nizde HTTP(S) web sitesi açın."
  },
  "hostApi": 1,
  "id": "com.rchub.browser",
  "license": "MIT",
  "name": {
    "en": "Browser",
    "tr": "Web Tarayıcısı"
  },
  "permissions": [
    "browser.open"
  ],
  "publisher": {
    "kind": "official",
    "name": "RCHub"
  },
  "schemaVersion": 1,
  "source": "https://github.com/CetTek/rchub-plugins/tree/v0.3.0/plugins/official/browser",
  "state": {
    "opened": {
      "type": "boolean"
    }
  },
  "targets": [
    "windows"
  ],
  "ui": {
    "color": "orange",
    "controls": [
      {
        "action": "open",
        "argument": "url",
        "id": "url",
        "inputMode": "url",
        "label": {
          "en": "Open website on PC",
          "tr": "PC’de web sitesi aç"
        },
        "placeholder": {
          "en": "https://example.com",
          "tr": "https://example.com"
        },
        "type": "input"
      },
      {
        "children": [
          {
            "action": "open",
            "argument": "url",
            "icon": "globe",
            "id": "google",
            "label": {
              "en": "Google",
              "tr": "Google"
            },
            "type": "button",
            "value": "https://www.google.com"
          },
          {
            "action": "open",
            "argument": "url",
            "icon": "globe",
            "id": "youtube",
            "label": {
              "en": "YouTube",
              "tr": "YouTube"
            },
            "type": "button",
            "value": "https://www.youtube.com"
          },
          {
            "action": "open",
            "argument": "url",
            "icon": "globe",
            "id": "github",
            "label": {
              "en": "GitHub",
              "tr": "GitHub"
            },
            "type": "button",
            "value": "https://github.com"
          }
        ],
        "id": "quick_sites",
        "label": {
          "en": "Quick sites",
          "tr": "Hızlı siteler"
        },
        "type": "section"
      },
      {
        "bind": "opened",
        "id": "opened",
        "label": {
          "en": "Browser accepted request",
          "tr": "Tarayıcı isteği kabul etti"
        },
        "type": "status"
      }
    ],
    "icon": "globe",
    "version": 1
  },
  "version": "0.3.0"
}
