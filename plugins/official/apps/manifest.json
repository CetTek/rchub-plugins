{
  "actions": [
    {
      "capability": "apps.read",
      "entry": 0,
      "id": "read",
      "input": {
        "properties": {
          "filter": {
            "enum": [
              "all",
              "foreground"
            ],
            "maxLength": 10,
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "output": {
        "properties": {
          "apps": {
            "items": {
              "properties": {
                "foreground": {
                  "type": "boolean"
                },
                "name": {
                  "maxLength": 120,
                  "type": "string"
                },
                "pid": {
                  "maximum": 2147483647,
                  "minimum": 1,
                  "type": "integer"
                },
                "started_at": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "title": {
                  "maxLength": 240,
                  "type": "string"
                },
                "window_id": {
                  "maxLength": 32,
                  "type": "string"
                }
              },
              "required": [
                "pid",
                "name",
                "title",
                "window_id",
                "started_at",
                "foreground"
              ],
              "type": "object"
            },
            "maxItems": 64,
            "type": "array"
          },
          "count": {
            "maximum": 64,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "apps",
          "count"
        ],
        "type": "object"
      }
    },
    {
      "capability": "apps.write",
      "entry": 1,
      "id": "stop",
      "input": {
        "properties": {
          "action": {
            "enum": [
              "stop",
              "close",
              "bring_to_front",
              "minimize",
              "maximize",
              "restore"
            ],
            "maxLength": 14,
            "type": "string"
          },
          "pid": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "started_at": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "window_id": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "pid",
          "action",
          "started_at"
        ],
        "type": "object"
      },
      "output": {
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ],
        "type": "object"
      }
    }
  ],
  "description": {
    "en": "List running processes and stop a selected PID.",
    "tr": "Çalışan işlemleri listeleyin ve seçtiğiniz PID’yi sonlandırın."
  },
  "hostApi": 1,
  "id": "com.rchub.apps",
  "license": "MIT",
  "name": {
    "en": "Apps",
    "tr": "Uygulamalar"
  },
  "permissions": [
    "apps.read",
    "apps.write"
  ],
  "publisher": {
    "kind": "official",
    "name": "RCHub"
  },
  "schemaVersion": 1,
  "source": "https://github.com/CetTek/rchub-plugins/tree/v0.3.0/plugins/official/apps",
  "state": {
    "accepted": {
      "type": "boolean"
    },
    "apps": {
      "items": {
        "properties": {
          "foreground": {
            "type": "boolean"
          },
          "name": {
            "maxLength": 120,
            "type": "string"
          },
          "pid": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          },
          "started_at": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "maxLength": 240,
            "type": "string"
          },
          "window_id": {
            "maxLength": 32,
            "type": "string"
          }
        },
        "required": [
          "pid",
          "name",
          "title",
          "window_id",
          "started_at",
          "foreground"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array"
    },
    "count": {
      "maximum": 64,
      "minimum": 0,
      "type": "integer"
    }
  },
  "targets": [
    "windows"
  ],
  "ui": {
    "color": "green",
    "controls": [
      {
        "action": "read",
        "argument": "filter",
        "id": "filter",
        "label": {
          "en": "Process view",
          "tr": "İşlem görünümü"
        },
        "options": [
          {
            "label": {
              "en": "Applications",
              "tr": "Uygulamalar"
            },
            "value": "foreground"
          },
          {
            "label": {
              "en": "All processes",
              "tr": "Tüm işlemler"
            },
            "value": "all"
          }
        ],
        "type": "select"
      },
      {
        "bind": "apps",
        "id": "processes",
        "itemActions": [
          {
            "action": "stop",
            "args": {
              "action": "bring_to_front"
            },
            "argument": "pid",
            "itemArguments": {
              "started_at": "started_at",
              "window_id": "window_id"
            },
            "label": {
              "en": "Bring to front",
              "tr": "Öne getir"
            }
          },
          {
            "action": "stop",
            "args": {
              "action": "minimize"
            },
            "argument": "pid",
            "itemArguments": {
              "started_at": "started_at",
              "window_id": "window_id"
            },
            "label": {
              "en": "Minimize",
              "tr": "Küçült"
            }
          },
          {
            "action": "stop",
            "args": {
              "action": "maximize"
            },
            "argument": "pid",
            "itemArguments": {
              "started_at": "started_at",
              "window_id": "window_id"
            },
            "label": {
              "en": "Maximize",
              "tr": "Büyüt"
            }
          },
          {
            "action": "stop",
            "args": {
              "action": "restore"
            },
            "argument": "pid",
            "itemArguments": {
              "started_at": "started_at",
              "window_id": "window_id"
            },
            "label": {
              "en": "Restore",
              "tr": "Geri yükle"
            }
          },
          {
            "action": "stop",
            "args": {
              "action": "close"
            },
            "argument": "pid",
            "confirm": {
              "message": {
                "en": "Unsaved work may be lost. Continue?",
                "tr": "Kaydedilmemiş çalışmalar kaybolabilir. Devam edilsin mi?"
              },
              "title": {
                "en": "Close window",
                "tr": "Pencereyi kapat"
              }
            },
            "itemArguments": {
              "started_at": "started_at",
              "window_id": "window_id"
            },
            "label": {
              "en": "Close window",
              "tr": "Pencereyi kapat"
            },
            "tone": "danger"
          },
          {
            "action": "stop",
            "args": {
              "action": "stop"
            },
            "argument": "pid",
            "confirm": {
              "message": {
                "en": "Unsaved work may be lost. Continue?",
                "tr": "Kaydedilmemiş çalışmalar kaybolabilir. Devam edilsin mi?"
              },
              "title": {
                "en": "Stop process",
                "tr": "İşlemi sonlandır"
              }
            },
            "itemArguments": {
              "started_at": "started_at",
              "window_id": "window_id"
            },
            "label": {
              "en": "Stop process",
              "tr": "İşlemi sonlandır"
            },
            "tone": "danger"
          }
        ],
        "itemLabel": "name",
        "itemValue": "pid",
        "label": {
          "en": "Select an application",
          "tr": "Bir uygulama seçin"
        },
        "searchable": true,
        "type": "list"
      },
      {
        "bind": "count",
        "id": "count",
        "label": {
          "en": "Listed processes (max 64)",
          "tr": "Listelenen işlemler (en fazla 64)"
        },
        "type": "value"
      }
    ],
    "icon": "apps",
    "version": 1
  },
  "version": "0.3.0"
}
