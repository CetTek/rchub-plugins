{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Repo-local experiment, not the existing V1 package or Socket.IO wire v2. Semantic checks are documented in README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "description", "source", "license", "permissions", "disclosure", "requiredFeatures", "execution", "actions", "events", "state", "surfaces", "storage"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "maxLength": 120, "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,8}$"},
    "version": {"type": "string", "maxLength": 32, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"$ref": "#/$defs/label"},
    "description": {"$ref": "#/$defs/label"},
    "source": {"type": "string", "minLength": 9, "maxLength": 300, "pattern": "^https://[^\\s]+$"},
    "license": {"type": "string", "minLength": 1, "maxLength": 40},
    "permissions": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "native.unsandboxed"}},
    "disclosure": {"type": "object", "additionalProperties": false, "required": ["nativeRisk", "dataBehavior"], "properties": {"nativeRisk": {"$ref": "#/$defs/label"}, "dataBehavior": {"$ref": "#/$defs/label"}}},
    "requiredFeatures": {"type":"array","maxItems":8,"uniqueItems":true,"items":{"enum":["native-process-v1","events-v1","surfaces-v1","scoped-store-v1","image-v1","string-8192-v1","list-item-actions-v1","surface-metadata-v1"]}},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "trust", "artifact"],
      "properties": {
        "kind": {"const": "installed-native"},
        "trust": {"const": "unsandboxed-user"},
        "artifact": {
          "type": "object", "additionalProperties": false,
          "required": ["target", "entry", "sha256"],
          "properties": {
            "target": {"enum": ["windows-x86_64", "linux-x86_64"]},
            "entry": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*(/[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "actions": {"type": "object", "minProperties": 1, "maxProperties": 32, "additionalProperties": {"$ref": "#/$defs/action"}},
    "events": {"type": "object", "maxProperties": 32, "additionalProperties": {"$ref": "#/$defs/record"}},
    "state": {"$ref": "#/$defs/record"},
    "surfaces": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/surface"}},
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["choices"],
      "properties": {"choices": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["native-filesystem", "host-scoped", "none"]}}}
    }
  },
  "$defs": {
    "label": {"type": "object", "additionalProperties": false, "required": ["en", "tr"], "properties": {"en": {"type": "string", "minLength": 1, "maxLength": 500}, "tr": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "name": {"type": "string", "maxLength": 160, "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*){2,10}$"},
    "token": {"type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"},
    "field": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "minimum", "maximum"], "properties": {"type": {"const": "integer"}, "minimum": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}, "maximum": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}}},
        {"type":"object","additionalProperties":false,"required":["type","maxLength"],"properties":{"type":{"const":"string"},"maxLength":{"type":"integer","minimum":1,"maximum":8192},"enum":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"type":"string","maxLength":8192}}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "maxLength"], "properties": {"type": {"const": "image"}, "maxLength": {"type": "integer", "minimum": 1, "maximum": 800000}}},
        {"$ref": "#/$defs/record"},
        {"type": "object", "additionalProperties": false, "required": ["type", "maxItems", "items"], "properties": {"type": {"const": "array"}, "maxItems": {"type": "integer", "minimum": 1, "maximum": 64}, "items": {"$ref": "#/$defs/field"}}}
      ]
    },
    "record": {
      "type": "object", "additionalProperties": false, "required": ["type", "properties", "required"],
      "properties": {
        "type": {"const": "object"},
        "properties": {"type": "object", "maxProperties": 32, "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"}, "additionalProperties": {"$ref": "#/$defs/field"}},
        "required": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["input", "output"],
      "properties": {"input": {"$ref": "#/$defs/record"}, "output": {"$ref": "#/$defs/record"}}
    },
    "surface": {
      "oneOf": [
         {"type": "object", "additionalProperties": false, "required": ["id", "kind", "clients", "actions", "events", "label", "controls"], "properties": {
          "id": {"$ref": "#/$defs/token"}, "kind": {"const": "declarative"},
          "clients": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["pc", "mobile", "web"]}},
          "actions": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
           "events": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
           "label": {"$ref": "#/$defs/label"},
           "icon":{"$ref":"#/$defs/icon"}, "color":{"enum":["blue","green","orange","purple","pink","teal","gray"]},
           "controls": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/control"}}
        }},
        {"type": "object", "additionalProperties": false, "required": ["id", "kind", "action", "trust"], "properties": {
          "id": {"$ref": "#/$defs/token"}, "kind": {"const": "extension-window"},
          "action": {"$ref": "#/$defs/name"}, "trust": {"const": "extension-owned-not-host-ui"}
        }}
      ]
     },
    "scalar": {"oneOf":[{"type":"string","maxLength":8192},{"type":"integer"},{"type":"boolean"}]},
    "icon":{"enum":["volume","power","cpu","apps","camera","keyboard","clipboard","globe","message","smile","puzzle","sun","play","info"]},
    "tone":{"enum":["default","primary","danger","muted"]},
    "confirm":{"type":"object","additionalProperties":false,"required":["title","message"],"properties":{"title":{"$ref":"#/$defs/label"},"message":{"$ref":"#/$defs/label"}}},
    "control": {
      "type": "object", "additionalProperties": false, "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "type": {"enum": ["section", "row", "column", "tabs", "text", "value", "status", "button", "toggle", "slider", "input", "select", "list", "progress", "image"]},
        "label": {"$ref": "#/$defs/label"},
        "icon":{"$ref":"#/$defs/icon"}, "tone":{"$ref":"#/$defs/tone"}, "confirm":{"$ref":"#/$defs/confirm"},
        "appearance":{"enum":["linear","ring"]}, "inputMode":{"enum":["text","numeric","url"]}, "placeholder":{"$ref":"#/$defs/label"}, "searchable":{"type":"boolean"},
        "children": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/control"}},
        "action": {"$ref": "#/$defs/name"},
        "bind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "argument": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "value": {"oneOf": [{"type": "string", "maxLength": 4096}, {"type": "integer"}, {"type": "boolean"}]},
        "defaultValue": {"oneOf": [{"type": "string", "maxLength": 4096}, {"type": "integer"}, {"type": "boolean"}]},
        "min": {"type": "integer"}, "max": {"type": "integer"}, "step": {"type": "integer", "minimum": 1},
        "submit": {"type": "boolean"}, "multiline": {"type": "boolean"},
        "inputBindings": {"type": "object", "maxProperties": 32, "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"}, "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"}},
        "options": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["label", "value"], "properties": {"label": {"$ref": "#/$defs/label"}, "value": {"oneOf": [{"type": "string", "maxLength": 4096}, {"type": "integer"}, {"type": "boolean"}]}}}},
        "itemLabel": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "itemValue": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "itemActions": {"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["label","action"],"properties":{"label":{"$ref":"#/$defs/label"},"action":{"$ref":"#/$defs/name"},"argument":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,39}$"},"value":{"$ref":"#/$defs/scalar"},"args":{"type":"object","maxProperties":32,"propertyNames":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,39}$"},"additionalProperties":{"$ref":"#/$defs/scalar"}},"itemArguments":{"type":"object","maxProperties":32,"propertyNames":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,39}$"},"additionalProperties":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,39}$"}},"icon":{"$ref":"#/$defs/icon"},"tone":{"$ref":"#/$defs/tone"},"confirm":{"$ref":"#/$defs/confirm"}}}}
      }
    }
  }
}
