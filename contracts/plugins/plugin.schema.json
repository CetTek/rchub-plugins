{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rchub.dev/schemas/plugin-v1.json",
  "title": "RCHub plugin development package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "manifest",
    "wasm"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "wasm": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16384,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "tr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "en",
        "tr"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "integer",
                "number"
              ]
            },
            "minimum": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "maximum": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "enum": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "minimum",
            "maximum"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            },
            "enum": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "maxLength"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean"
            },
            "enum": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "boolean"
              },
              "minItems": 1
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "array"
            },
            "maxItems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "items": {
              "$ref": "#/$defs/field"
            }
          },
          "required": [
            "type",
            "maxItems",
            "items"
          ]
        },
        {
          "$ref": "#/$defs/object"
        }
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "type",
        "properties",
        "required"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "entry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "capability": {
          "enum": [
            "apps.read",
            "apps.write",
            "audio.read",
            "audio.write",
            "browser.open",
            "clipboard.read",
            "clipboard.write",
            "display.read",
            "display.write",
            "effects.write",
            "keyboard.write",
            "media.write",
            "power.write",
            "screenshot.read",
            "speech.write",
            "system.read"
          ]
        },
        "input": {
          "$ref": "#/$defs/object"
        },
        "output": {
          "$ref": "#/$defs/object"
        }
      },
      "required": [
        "id",
        "entry",
        "capability",
        "input",
        "output"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "section",
            "row",
            "column",
            "button",
            "slider",
            "toggle",
            "select",
            "text",
            "value",
            "status",
            "input",
            "list",
            "image",
            "progress",
            "tabs"
          ]
        },
        "label": {
          "$ref": "#/$defs/localizedControl"
        },
        "icon": {
          "enum": [
            "volume",
            "power",
            "cpu",
            "apps",
            "camera",
            "keyboard",
            "clipboard",
            "globe",
            "message",
            "smile",
            "puzzle",
            "sun",
            "play",
            "info"
          ]
        },
        "tone": {
          "enum": [
            "default",
            "primary",
            "danger",
            "muted"
          ]
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/control"
          }
        },
        "action": {
          "$ref": "#/$defs/id"
        },
        "bind": {
          "$ref": "#/$defs/id"
        },
        "argument": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": [
            "string",
            "integer",
            "boolean"
          ],
          "maxLength": 32768,
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "min": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "options": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/$defs/localizedControl"
              },
              "value": {
                "type": [
                  "string",
                  "integer",
                  "boolean"
                ],
                "maxLength": 32768,
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "label",
              "value"
            ]
          },
          "minItems": 1
        },
        "placeholder": {
          "$ref": "#/$defs/localizedControl"
        },
        "itemLabel": {
          "$ref": "#/$defs/id"
        },
        "itemValue": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "slider"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "bind",
              "action",
              "argument",
              "min",
              "max",
              "step"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "toggle",
                  "select"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "bind",
              "action",
              "argument"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "input"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "action",
              "argument"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "button"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "action"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "progress"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "bind",
              "min",
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "value",
                  "status",
                  "list",
                  "image"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "bind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "select"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "section",
                  "row",
                  "column",
                  "tabs"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "action"
                  ]
                },
                {
                  "required": [
                    "bind"
                  ]
                },
                {
                  "required": [
                    "argument"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                },
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "placeholder"
                  ]
                },
                {
                  "required": [
                    "itemLabel"
                  ]
                },
                {
                  "required": [
                    "itemValue"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "button",
                  "slider",
                  "toggle",
                  "select",
                  "text",
                  "value",
                  "status",
                  "input",
                  "list",
                  "image",
                  "progress"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "children"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "options"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "select"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "placeholder"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "input"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "itemLabel"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "list"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "itemValue"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "list"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "min"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "slider",
                  "progress"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "max"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "slider",
                  "progress"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "step"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "slider",
                  "progress"
                ]
              }
            }
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){2,8}$"
        },
        "version": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "name": {
          "$ref": "#/$defs/localizedName"
        },
        "description": {
          "$ref": "#/$defs/localized"
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "kind": {
              "enum": [
                "official",
                "community"
              ]
            }
          },
          "required": [
            "name",
            "kind"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 300
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "windows",
              "linux"
            ]
          }
        },
        "hostApi": {
          "const": 1
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "enum": [
              "apps.read",
              "apps.write",
              "audio.read",
              "audio.write",
              "browser.open",
              "clipboard.read",
              "clipboard.write",
              "display.read",
              "display.write",
              "effects.write",
              "keyboard.write",
              "media.write",
              "power.write",
              "screenshot.read",
              "speech.write",
              "system.read"
            ]
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "state": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "icon": {
              "enum": [
                "volume",
                "power",
                "cpu",
                "apps",
                "camera",
                "keyboard",
                "clipboard",
                "globe",
                "message",
                "smile",
                "puzzle",
                "sun",
                "play",
                "info"
              ]
            },
            "color": {
              "enum": [
                "blue",
                "green",
                "orange",
                "purple",
                "pink",
                "teal",
                "gray"
              ]
            },
            "controls": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/control"
              }
            }
          },
          "required": [
            "version",
            "icon",
            "color",
            "controls"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "version",
        "name",
        "description",
        "publisher",
        "license",
        "source",
        "targets",
        "hostApi",
        "permissions",
        "actions",
        "state",
        "ui"
      ]
    },
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "tr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "en",
        "tr"
      ]
    },
    "localizedControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "tr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "en",
        "tr"
      ]
    }
  },
  "$comment": "Structural schema. SDK and host validators additionally enforce UTF-16 string lengths, nesting<=3, total UI depth/count, unique action/control identities, sorted grants, source URL safety, min<=max and all action/state/control reference and value compatibility. JSON Schema maxLength counts Unicode codepoints, so SDK/host validation remains mandatory."
}
